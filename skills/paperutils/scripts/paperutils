#!/usr/bin/env python3
"""Run paperutils from a source checkout without installing dependencies."""

from __future__ import annotations

import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT / "src"))

from paperutils.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())